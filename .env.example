# ArcticBlue Event Tracker — environment variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# Dust.tt — agent ArcticBlueEventSpeaking
DUST_API_KEY=sk-paste-key-here
DUST_WORKSPACE_ID=G5QCSmfJhK
DUST_AGENT_ID=Dir04hvKfi
DUST_DOMAIN=https://dust.tt

# Supabase (server-side). SUPABASE_URL + SUPABASE_PUBLISHABLE_KEY are used by
# /api/vet and /api/search to verify the caller's editor token.
SUPABASE_URL=https://efkvhlmfdwlobvdmvqiq.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable-paste-here

# /api/events — inbound event ingest (Dust agent pushes new events here).
#   SUPABASE_SERVICE_ROLE_KEY: from Supabase → Project Settings → API →
#     "service_role" secret. SERVER-SIDE ONLY. Never commit; never expose to
#     the browser. It bypasses RLS so the endpoint can insert manual_events.
#   EVENTS_INGEST_SECRET: a long random string the caller sends as the
#     X-API-Key header. Generate with:  python3 -c "import secrets;print(secrets.token_urlsafe(40))"
SUPABASE_SERVICE_ROLE_KEY=paste-service-role-secret-here
EVENTS_INGEST_SECRET=paste-a-long-random-string-here

# /api/mcp — Remote MCP server the Dust agent calls IN-CHAT (no API tokens).
#   The agent's `add_events` tool posts found events here; this server forwards
#   them into /api/events (gate + insert). Dust authenticates with a Bearer
#   token you also paste into Dust → Tools when adding the remote MCP server.
#   MCP_BEARER_TOKEN: the token Dust sends as `Authorization: Bearer ...`.
#     OPTIONAL — if unset it falls back to EVENTS_INGEST_SECRET, so you can
#     reuse that one value and set no new Vercel env var. Set a dedicated one
#     here if you prefer Dust to hold a separate secret from the door key.
MCP_BEARER_TOKEN=optional-separate-token-or-leave-unset

# /api/events — OpenAI "worthiness" gate (OPTIONAL).
#   If OPENAI_API_KEY is set, each genuinely-new event is judged by the model
#   (ArcticBlue profile + rubric in api/events.py) and only accepted events are
#   inserted; rejected ones are returned in the response with a reason. Leave
#   OPENAI_API_KEY unset to skip the gate and insert every new event.
#   OPENAI_MODEL defaults to gpt-4o-mini. OPENAI_GATE_FAIL_OPEN=true (default)
#   keeps an event when the model errors; set false to drop it instead.
OPENAI_API_KEY=sk-openai-paste-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_GATE_FAIL_OPEN=true
