{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/vet.py": {
      "maxDuration": 120
    },
    "api/search.py": {
      "maxDuration": 120
    },
    "api/events.py": {
      "maxDuration": 60,
      "includeFiles": "config/personas.json"
    },
    "api/mcp.py": {
      "maxDuration": 120
    },
    "api/enrich.py": {
      "maxDuration": 120
    },
    "api/calendars.py": {
      "maxDuration": 60
    },
    "api/briefing.py": {
      "maxDuration": 300,
      "includeFiles": "config/personas.json"
    }
  },
  "crons": [
    {
      "path": "/api/briefing?cron=1",
      "schedule": "0 6 * * *"
    }
  ],
  "headers": [
    {
      "source": "/calendar.ics",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/calendar; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/angela",
      "destination": "/index.html"
    },
    {
      "source": "/angela/",
      "destination": "/index.html"
    }
  ]
}
