  "narrative": {
    "northStar": "The Field Ledger",
    "overview": "A working ledger for a small team in the field. Pages are white and quiet; ink-black type carries the content; small uppercase mono labels carry dates, counts and field names the way a ledger's column heads do. Color is rationed: ArcticBlue blue means \"act here\", and the pipeline stage colors mean \"where this stands\". Nothing is decorative for its own sake.",
    "keyCharacteristics": [
      "White paper, ink type, hairline rules (1px #e7e7e8) instead of shadows at rest.",
      "Three type voices: Hanken Grotesk for reading, Nunito Sans for controls, Fragment Mono uppercase for labels and metadata; Helvetica Bold only for the app title (matches the logo).",
      "One action blue; stage colors only for pipeline status.",
      "Shape encodes behavior: squared labels are static, underlined pills are clickable."
    ],
    "rules": [
      {
        "name": "The One Blue Rule",
        "body": "Text and interactive states use ArcticBlue Action (#2773c2) or Glacier Deep (#1271a8). Glacier (#1fa0dc) is for large brand marks only.",
        "section": "colors"
      },
      {
        "name": "The Status-Only Color Rule",
        "body": "Stage colors mean pipeline status and nothing else. Purple outside the \"Meeting held\" stage (AI features, people, regions) competes with it and should not be added.",
        "section": "colors"
      },
      {
        "name": "The 11px Floor Rule",
        "body": "No rendered text below 11px. Mono labels sit at 0.7rem (11.2px) or above; several (dates, avatars, counts, carets) currently render at 9 to 10.5px and are known violations.",
        "section": "typography"
      },
      {
        "name": "The Flat Page Rule",
        "body": "Cards and panels carry a 1px rule, not a shadow. Colored glows (for example the hidden Action Center dialog's #142844 glow) are off-system.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use ArcticBlue Action (#2773c2) for any blue text or action, and Glacier (#1fa0dc) only for the large app title and brand marks.",
      "Do keep labels squared and clickable controls as underlined pills.",
      "Do show \"contact on file\" style facts as a bare icon with a tooltip, not a badge.",
      "Do keep text at 11px or larger and body copy at 4.5:1 contrast or better."
    ],
    "donts": [
      "Don't add new purple accents; purple belongs to the \"Meeting held\" stage.",
      "Don't put shadows or colored glows on cards or panels at rest.",
      "Don't use em dashes in UI copy.",
      "Don't replace Nunito Sans, Hanken Grotesk or Fragment Mono, or the Helvetica app title."
    ]
  }
}